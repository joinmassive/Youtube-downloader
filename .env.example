# Local runtime state
VIDEO_JOBS_DATABASE=./video-jobs.db
VIDEO_JOBS_LOCAL_STORAGE=./artifacts
VIDEO_JOBS_WORKER_CONCURRENCY=20
VIDEO_JOBS_MAX_ATTEMPTS=3
VIDEO_JOBS_RETRY_BASE_SECONDS=5
VIDEO_JOBS_RETRY_MAX_SECONDS=120
# Optional start-rate limiter. 0 means disabled; active worker concurrency remains 20.
VIDEO_JOBS_STARTS_PER_SECOND=0
VIDEO_JOBS_LEASE_SECONDS=120
VIDEO_JOBS_HEARTBEAT_SECONDS=30
# Capture Massive X-Exit-* metadata once per strict session (one extra CONNECT).
VIDEO_JOBS_CAPTURE_EXIT_METADATA=true

# JavaScript runtime for modern YouTube player extraction. `deno` uses PATH.
YTDLP_JS_RUNTIME=deno
YTDLP_SOCKET_TIMEOUT=45
# Comma-separated yt-dlp YouTube player clients. Leave unset to use yt-dlp's
# defaults; android_vr now requires a PO token and returns HTTP 403 without one.
# YTDLP_YOUTUBE_PLAYER_CLIENTS=

# Massive Residential (keep real credentials only in .env)
PROXY_HOST=network.joinmassive.com
PROXY_PORT=65534
PROXY_USER=replace-me
PROXY_PASS=replace-me
# PROXY_COUNTRY=US
# PROXY_SESSION_TTL=30

# Optional signing key for completion webhooks
# VIDEO_JOBS_WEBHOOK_SECRET=replace-with-a-random-secret
